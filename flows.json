        "id": "6840547f0869be0e",
        "type": "function",
        "z": "a9c741e10837f545",
        "name": "Build Response Suhu",
        "func": "var API_KEY = 'rahasia123';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key salah atau tidak ada'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nvar data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nvar batas = flow.get('threshold');\nif (batas === undefined) { batas = 35; }\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: batas,\n    server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
        "outputs": 1,

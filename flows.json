        "z": "a9c741e10837f545",
        "name": "Set Batas Suhu",
        "func": "var API_KEY = 'rahasia123';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key salah atau tidak ada'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nvar b = msg.payload ? msg.payload.batas : undefined;\nif (typeof b !== 'number' || isNaN(b)) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'batas harus berupa angka'};\n} else {\n    flow.set('threshold', b);\n    msg.payload = {status: 'success', message: 'Batas suhu diperbarui', threshold: b};\n}\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",

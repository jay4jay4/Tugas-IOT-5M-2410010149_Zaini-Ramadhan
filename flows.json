        "name": "Build Response History",
        "func": "var rows = msg.payload || [];\nrows.forEach(function (r) { r.alert = !!r.alert; });\nmsg.payload = {\n    status: 'success',\n    source: 'sqlite',\n    count: rows.length,\n    data: rows\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",

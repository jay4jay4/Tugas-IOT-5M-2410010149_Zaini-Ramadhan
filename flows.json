        "type": "function",
        "z": "a9c741e10837f545",
        "name": "Siapkan INSERT",
        "func": "var d = msg.payload;\nmsg.params = {\n    $suhu: d.suhu,\n    $kel: d.kelembaban,\n    $ts: d.timestamp,\n    $rec: d.received,\n    $alert: d.alert ? 1 : 0\n};\nreturn msg;",

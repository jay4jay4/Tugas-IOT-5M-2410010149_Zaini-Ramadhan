    {
        "id": "1fb71fd6ed2dce25",
        "type": "function",
        "z": "a9c741e10837f545",
        "name": "Proses Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nvar batas = flow.get('threshold');\nif (batas === undefined) { batas = 35; }\ndata.alert = data.suhu > batas;\nflow.set('lastSensor', data);\n\nvar peringatan = null;\nif (data.alert) {\n    peringatan = {payload: 'PERINGATAN: suhu ' + data.suhu + ' C melebihi batas ' + batas + ' C'};\n}\nreturn [msg, peringatan];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 190,
